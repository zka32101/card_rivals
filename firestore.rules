rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============== ユーザー配下（個人データ） ===============
    match /users/{userId} {
      // 本人のみ読み書き可
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // ウォレット（コイン・ジェム残高）
      match /wallet/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 今日のきもちカード
      match /daily_emotions/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // きもちカード統計（連続記録・属性別集計）
      match /daily_emotion_stats/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // デイリーミッション
      match /missions/{missionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // 属性移住状態（週替わりの属性ボーナス。移住時にコインと合わせて保存する）
      match /migration/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // ユーザーが作成したカード（コインを消費して作成。特訓レベルもここに保存）。
      // isPublic=trueのカードは、レンタル一覧（collectionGroupクエリ）で他ユーザーからも
      // 読み取れる必要がある。
      //
      // 新規作成・attackPower/defensePower/speed/level/cost/attributeの変更は
      // createCard/levelUpCard Cloud Functionのみが行う（Admin SDK経由でこのルールの
      // 対象外）。これらはPvPバトルの実ダメージ計算にそのまま使われるため、
      // ratingやseasonProgressと同じ深刻さでクライアントの自己申告を信用できない
      // —— 以前はここが本人uidチェックのみでフィールド内容を一切検証しておらず、
      // 改造クライアント/直接呼び出しでattackPowerやlevelを任意の値に詐称できた。
      // isPublic（レンタル公開切替）・rentalCostPerDay等、戦闘に関わらないフィールドの
      // 更新は引き続き本人がクライアントから直接行える。
      match /cards/{cardId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || resource.data.isPublic == true);
        allow create: if false;
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.attackPower == resource.data.attackPower &&
          request.resource.data.defensePower == resource.data.defensePower &&
          request.resource.data.speed == resource.data.speed &&
          request.resource.data.level == resource.data.level &&
          request.resource.data.cost == resource.data.cost &&
          request.resource.data.attribute == resource.data.attribute;
        allow delete: if false;
      }

      // PvPレーティング（pvpBattle Cloud Functionのみが更新。クライアントは本人の分を読み取りのみ）
      match /rating/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // シーズン進捗（pvpBattle Cloud Functionが勝敗を反映し、claimSeasonReward
      // Cloud Functionがリワード請求を反映する。クライアントは本人の分を読み取りのみ
      // —— ratingと同じ方針。かつてはここもクライアントの直接書き込みが許可されており、
      // 実際の対戦結果と無関係にランク/ポイントを自己申告できてしまっていた）。
      match /seasonProgress/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // デッキプリセット（バトル用のカード5枚編成を最大5件まで保存）。
      // 戦闘の実ダメージ計算に関わるフィールド（attackPower等）はcardsコレクション側で
      // 別途検証済みのため、ここではcardIdsの参照先を持つだけの本人専用メモとして扱い、
      // 本人のみ読み書き可能にする。
      match /deckPresets/{presetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // =============== カードレンタル取引記録 ===============
    // renterUid/creatorUid 双方の当事者のみ読み取り可能。書き込みは常にfalse
    // —— rentCard Cloud FunctionがAdmin SDK経由でのみ作成する（通貨移動を伴うため
    //     クライアントの直接書き込みは許可しない。他のPvP/購入系と同じ方針）。
    match /rentals/{rentalId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.renterUid || request.auth.uid == resource.data.creatorUid);
      allow write: if false;
    }
  }
}
