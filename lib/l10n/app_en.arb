  "explanation_page1Title": "Battle Mechanics",
  "explanation_page1Description": "Learn how battles work in Card Rivals.\n\nEach battle starts with 30 HP. The player with higher remaining HP wins.",
  "explanation_page1Detail1": "Damage = Attacker's Attack - Defender's Defense",
  "explanation_page1Detail2": "Minimum 1 damage is guaranteed",
  "explanation_page1Detail3": "Higher speed cards may attack first",
  "explanation_page2Title": "Card Stats",
  "explanation_page2Description": "Every card has three core stats:\n\nAttack determines damage dealt.\nDefense reduces incoming damage.\nSpeed affects attack order and special abilities.",
  "explanation_page2Detail1": "Attack: Increases damage dealt to opponents",
  "explanation_page2Detail2": "Defense: Reduces damage taken from attacks",
  "explanation_page2Detail3": "Speed: Affects turn order and card abilities",
  "explanation_page3Title": "Damage Multipliers",
  "explanation_page3Description": "Attribute matchups create a rock-paper-scissors advantage system.\n\nJoy beats Anger, Anger beats Sadness, Sadness beats Joy.\nGeneral matchup bonus: +50% or -33% damage.",
  "explanation_page3Detail1": "Strong attribute: 1.5x damage multiplier",
  "explanation_page3Detail2": "Same attribute: 1.0x damage multiplier",
  "explanation_page3Detail3": "Weak attribute: 0.67x damage multiplier",
  "explanation_page3Detail4": "Critical hits and other effects apply after multipliers",
  "explanation_page4Title": "Special Abilities",
  "explanation_page4Description": "Different card types gain unique battle advantages:\n\nAttack cards: Better critical hit rate\nDefense cards: Shield protection from damage\nSpeed cards: Complete dodge ability",
  "explanation_page4Detail1": "Shield blocks 50% of damage (20% activation rate)",
  "explanation_page4Detail2": "Dodge negates damage entirely (15% activation rate)",
  "explanation_page4Detail3": "Critical hit adds 50% bonus damage (varies by card type)",
  "explanation_page5Title": "Migration System",
  "explanation_page5Description": "Migrate to boost your chosen attribute for a week.\n\nMigration to the weekly favored attribute grants a bonus to all damage dealt with that attribute. Rotates weekly: Joy → Anger → Sadness.",
  "explanation_page5Detail1": "Costs 50 coins per migration",
  "explanation_page5Detail2": "Bonus applies when using migrated attribute cards",
  "explanation_page5Detail3": "Resets when the week changes",
  "explanation_page6Title": "Card Types",
  "explanation_page6Description": "When creating cards, choose Attack, Defense, or Speed types.\n\nEach type influences your card's stats and grants special battle abilities.",
  "explanation_page6Detail1": "Attack type: Higher damage, +10% critical rate",
  "explanation_page6Detail2": "Defense type: Better protection, 20% shield activation",
  "explanation_page6Detail3": "Speed type: Faster turns, 15% dodge ability",
  "explanation_page7Title": "Card Rental",
  "explanation_page7Description": "Earn passive income by renting out your cards to other players.\n\nMake a card public to let others use it in battle for 1 coin per match.",
  "explanation_page7Detail1": "You earn 40% of the rental fee",
  "explanation_page7Detail2": "Rental earnings accumulate monthly",
  "explanation_page7Detail3": "Toggle Public to make cards available for rental",
  "home_explanationTooltip": "Game Guide"
}
